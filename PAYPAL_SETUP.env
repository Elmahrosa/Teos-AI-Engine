# ─── ADD THESE TO YOUR .env ───────────────────────────────────────────────────

# Your PayPal.me link (go to paypal.me — log in — "Get your PayPal.me link")
# Format: https://paypal.me/YourUsername
NEXT_PUBLIC_PAYPAL_ME=https://paypal.me/ElmahrosaTEOS

# ──────────────────────────────────────────────────────────────────────────────
# HOW TO GET YOUR PAYPAL.ME LINK
# 1. Go to https://www.paypal.com/paypalme/
# 2. Log in to your PayPal account
# 3. Set your PayPal.me username (e.g. ElmahrosaTEOS)
# 4. Your link becomes: https://paypal.me/ElmahrosaTEOS
# 5. Replace the value above with your actual link
#
# HOW IT WORKS IN THE APP
# - User clicks "Pay $29 with PayPal" → opens https://paypal.me/ElmahrosaTEOS/29USD
# - PayPal handles the payment securely
# - User copies Transaction ID from PayPal receipt email
# - User submits TX ID via dashboard → creates a 'pending' BillingEvent
# - Admin sees it in /admin panel → clicks Approve → plan activates
#
# NO WEBHOOK OR PAYPAL API KEY NEEDED FOR THIS FLOW
# This is a manual confirmation flow — same as USDC/Pi — simple and zero setup cost.
# ──────────────────────────────────────────────────────────────────────────────
