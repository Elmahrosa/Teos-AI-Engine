import { PrismaClient, UserPlan, UserStatus, BillingStatus } from "@prisma/client";

const prisma = new PrismaClient();

export async function findUserByEmail(email: string) {
  return prisma.user.findUnique({
    where: { email: email.toLowerCase() },
    select: {
      id: true,
      email: true,
      name: true,
      plan: true,
      status: true,      // ✅ Critical for API route checks
      trialStart: true,  // ✅ Critical for API route checks
      posts: {
        orderBy: { createdAt: "desc" },
      },
    },
  });
}

export async function createUser(data: {
  email: string;
  name: string;
  plan?: UserPlan;
  status?: UserStatus;
  trialStart?: Date;
}) {
  return prisma.user.create({
    data,
    select: {
      id: true,
      email: true,
      name: true,
      plan: true,
      status: true,
      trialStart: true,
    },
  });
}

export async function listUsers() {
  return prisma.user.findMany({
    orderBy: { createdAt: "desc" },
    select: {
      id: true,
      email: true,
      name: true,
      plan: true,
      status: true,
      trialStart: true,
      createdAt: true,
      updatedAt: true,
      posts: {
        select: { id: true },
      },
    },
  });
}

export async function logBillingEvent(data: {
  provider: string;
  externalEventId?: string;
  invoiceId?: string;
  status: BillingStatus;
  plan?: UserPlan;
  payload: any;
  userId?: string;
}) {
  return prisma.billingEvent.create({
    data,
  });
}
